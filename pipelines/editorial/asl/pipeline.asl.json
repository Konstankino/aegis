{
  "Comment": "Editorial pipeline (Aegis scenario): S3-ingestion-only. A *.txt dropped in the source bucket starts one execution (input = {source_bucket, source_key}); the agent-ingest stage fetches it with a short-lived, object-scoped JIT credential, then a linear A -> B -> C chain runs. There are NO per-agent Lambdas — the SAME agent function is invoked with a different agent_id (the Cedar principal) each stage, every tool call mediated by the Aegis inline-plane gate (pipelines/editorial/policies/broker.cedar).",
  "StartAt": "Ingest",
  "States": {
    "Ingest": {
      "Type": "Task",
      "Comment": "Agent ingest (principal agent-ingest): the ONLY entry point. Fetch the dropped *.txt with a SHORT-LIVED, object-scoped credential minted by the JIT broker (/credentials/issue), then hand its text to Agent A. May invoke ONLY source.read (broker-enforced).",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${agent_lambda_arn}",
        "Payload": {
          "agent_id": "agent-ingest",
          "run_id.$": "$$.Execution.Name",
          "thread_id.$": "$$.Execution.Name",
          "source_bucket.$": "$.source_bucket",
          "source_key.$": "$.source_key",
          "source_version_id.$": "$.source_version_id",
          "source_etag.$": "$.source_etag"
        }
      },
      "ResultSelector": {
        "thread_id.$": "$$.Execution.Name",
        "text.$": "$.Payload.output"
      },
      "Retry": [
        {
          "ErrorEquals": ["Lambda.TooManyRequestsException", "Lambda.ServiceException", "States.TaskFailed"],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "Failed", "ResultPath": "$.error" }],
      "Next": "AgentA_Grammar"
    },
    "AgentA_Grammar": {
      "Type": "Task",
      "Comment": "Agent A (principal agent-a): correct grammar, then call send.to_agent_b. May invoke ONLY grammar.correct + send.to_agent_b (broker-enforced).",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${agent_lambda_arn}",
        "Payload": {
          "agent_id": "agent-a",
          "run_id.$": "$$.Execution.Name",
          "thread_id.$": "$.thread_id",
          "input.$": "$.text"
        }
      },
      "ResultSelector": { "text.$": "$.Payload.output" },
      "ResultPath": "$.a",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.TooManyRequestsException", "Lambda.ServiceException", "States.TaskFailed"],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "Failed", "ResultPath": "$.error" }],
      "Next": "AgentB_Enrich"
    },
    "AgentB_Enrich": {
      "Type": "Task",
      "Comment": "Agent B (principal agent-b): add interesting, sound facts, then call send.to_agent_c with BOTH versions as candidates. May invoke ONLY enrich.add_facts + send.to_agent_c.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${agent_lambda_arn}",
        "Payload": {
          "agent_id": "agent-b",
          "run_id.$": "$$.Execution.Name",
          "thread_id.$": "$.thread_id",
          "input.$": "$.a.text"
        }
      },
      "ResultSelector": { "candidates.$": "$.Payload.candidates" },
      "ResultPath": "$.b",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.TooManyRequestsException", "Lambda.ServiceException", "States.TaskFailed"],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "Failed", "ResultPath": "$.error" }],
      "Next": "AgentC_Referee"
    },
    "AgentC_Referee": {
      "Type": "Task",
      "Comment": "Agent C (principal agent-c): referee.select the best candidate, then publish.final. May invoke ONLY referee.select + publish.final.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${agent_lambda_arn}",
        "Payload": {
          "agent_id": "agent-c",
          "run_id.$": "$$.Execution.Name",
          "thread_id.$": "$.thread_id",
          "candidates.$": "$.b.candidates"
        }
      },
      "ResultSelector": { "final.$": "$.Payload.output" },
      "ResultPath": "$.c",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.TooManyRequestsException", "Lambda.ServiceException", "States.TaskFailed"],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "Failed", "ResultPath": "$.error" }],
      "Next": "Respond"
    },
    "Respond": {
      "Type": "Pass",
      "Comment": "The referee's chosen final text.",
      "Parameters": { "status": "done", "thread_id.$": "$.thread_id", "final.$": "$.c.final" },
      "End": true
    },
    "Failed": {
      "Type": "Fail",
      "Error": "EditorialPipelineFailed",
      "Cause": "A stage of the A->B->C pipeline failed; see $.error and the audit ledger."
    }
  }
}
