{
  "Comment": "Parallel-review pipeline (Aegis): a fan-out/fan-in chain. Agent A prepares the text, then Agents B and C improve it IN PARALLEL (a Step Functions Parallel state), and Agent D referees the two candidates. There are NO per-agent Lambdas — the SAME agent function is invoked per stage with a different agent_id (the Cedar principal). Each invocation mediates every tool call through the Aegis inline-plane gate, which applies the per-agent least-privilege policy (pipelines/parallel-review/policies/broker.cedar).",
  "StartAt": "Init",
  "States": {
    "Init": {
      "Type": "Pass",
      "Comment": "Seed the run: a thread id correlates the audit ledger + taint across the whole fan-out.",
      "Parameters": {
        "thread_id.$": "$$.Execution.Name",
        "text.$": "$.input"
      },
      "Next": "AgentA_Prepare"
    },
    "AgentA_Prepare": {
      "Type": "Task",
      "Comment": "Agent A (principal agent-a): light grammar, then dispatch.to_workers. May invoke ONLY grammar.correct + dispatch.to_workers.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${agent_lambda_arn}",
        "Payload": {
          "agent_id": "agent-a",
          "run_id.$": "$$.Execution.Name",
          "thread_id.$": "$.thread_id",
          "input.$": "$.text"
        }
      },
      "ResultSelector": { "text.$": "$.Payload.output" },
      "ResultPath": "$.a",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.TooManyRequestsException", "Lambda.ServiceException", "States.TaskFailed"],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "Failed", "ResultPath": "$.error" }],
      "Next": "Improve"
    },
    "Improve": {
      "Type": "Parallel",
      "Comment": "Fan-out: Agents B and C (principals agent-b / agent-c) improve A's text CONCURRENTLY. Each may invoke ONLY improve.text + submit.candidate. Fan-in collects both candidates for the referee.",
      "Branches": [
        {
          "StartAt": "AgentB_Improve",
          "States": {
            "AgentB_Improve": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${agent_lambda_arn}",
                "Payload": {
                  "agent_id": "agent-b",
                  "run_id.$": "$$.Execution.Name",
                  "thread_id.$": "$.thread_id",
                  "input.$": "$.a.text"
                }
              },
              "ResultSelector": { "text.$": "$.Payload.output" },
              "End": true
            }
          }
        },
        {
          "StartAt": "AgentC_Improve",
          "States": {
            "AgentC_Improve": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${agent_lambda_arn}",
                "Payload": {
                  "agent_id": "agent-c",
                  "run_id.$": "$$.Execution.Name",
                  "thread_id.$": "$.thread_id",
                  "input.$": "$.a.text"
                }
              },
              "ResultSelector": { "text.$": "$.Payload.output" },
              "End": true
            }
          }
        }
      ],
      "ResultSelector": { "candidates.$": "$[*].text" },
      "ResultPath": "$.improve",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.TooManyRequestsException", "Lambda.ServiceException", "States.TaskFailed"],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "Failed", "ResultPath": "$.error" }],
      "Next": "AgentD_Referee"
    },
    "AgentD_Referee": {
      "Type": "Task",
      "Comment": "Agent D (principal agent-d): referee.select the best candidate, then publish.final. May invoke ONLY referee.select + publish.final.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${agent_lambda_arn}",
        "Payload": {
          "agent_id": "agent-d",
          "run_id.$": "$$.Execution.Name",
          "thread_id.$": "$.thread_id",
          "candidates.$": "$.improve.candidates"
        }
      },
      "ResultSelector": { "final.$": "$.Payload.output" },
      "ResultPath": "$.d",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.TooManyRequestsException", "Lambda.ServiceException", "States.TaskFailed"],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "Failed", "ResultPath": "$.error" }],
      "Next": "Respond"
    },
    "Respond": {
      "Type": "Pass",
      "Comment": "The referee's chosen final text.",
      "Parameters": { "status": "done", "thread_id.$": "$.thread_id", "final.$": "$.d.final" },
      "End": true
    },
    "Failed": {
      "Type": "Fail",
      "Error": "ParallelReviewPipelineFailed",
      "Cause": "A stage of the A->(B||C)->D pipeline failed; see $.error and the audit ledger."
    }
  }
}
