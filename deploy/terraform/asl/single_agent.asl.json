{
  "Comment": "Aegis single-agent stack: Step Functions is the durable loop. It invokes the agent Lambda for one turn; on a final answer it responds, on a human_approve it pauses on .waitForTaskToken and loops back after approval. Placeholders ${agent_lambda_arn} and ${approval_queue_url} are injected by Terraform.",
  "StartAt": "Init",
  "States": {
    "Init": {
      "Type": "Pass",
      "Comment": "Seed the first turn's input.",
      "Parameters": {
        "thread_id.$": "$.thread_id",
        "input.$": "$.input"
      },
      "Next": "AgentTurn"
    },

    "AgentTurn": {
      "Type": "Task",
      "Comment": "Run one LLM+tool turn. The agent mediates every tool call through the Aegis gate.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${agent_lambda_arn}",
        "Payload.$": "$"
      },
      "ResultSelector": {
        "status.$": "$.Payload.status",
        "payload.$": "$.Payload"
      },
      "ResultPath": "$.turn",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.TooManyRequestsException",
            "Lambda.ServiceException",
            "States.TaskFailed"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "Failed" }],
      "Next": "Decide"
    },

    "Decide": {
      "Type": "Choice",
      "Comment": "Branch on the turn's status.",
      "Choices": [
        { "Variable": "$.turn.status", "StringEquals": "done", "Next": "Respond" },
        { "Variable": "$.turn.status", "StringEquals": "needs_approval", "Next": "RequestApproval" }
      ],
      "Default": "Failed"
    },

    "RequestApproval": {
      "Type": "Task",
      "Comment": "HUMAN-IN-THE-LOOP: the broker returned human_approve. Pause durably; the task token goes to SQS. A human (or the approver Lambda) calls SendTaskSuccess to resume.",
      "Resource": "arn:aws:states:::sqs:sendMessage.waitForTaskToken",
      "TimeoutSeconds": 3600,
      "Parameters": {
        "QueueUrl": "${approval_queue_url}",
        "MessageBody": {
          "taskToken.$": "$$.Task.Token",
          "thread_id.$": "$.thread_id",
          "pending.$": "$.turn.payload.pending",
          "capability.$": "$.turn.payload.capability"
        }
      },
      "ResultPath": "$.approval",
      "Catch": [{ "ErrorEquals": ["States.Timeout", "States.TaskFailed"], "ResultPath": "$.error", "Next": "Failed" }],
      "Next": "Resume"
    },

    "Resume": {
      "Type": "Pass",
      "Comment": "Rebuild a clean resume payload and loop back into the agent.",
      "Parameters": {
        "thread_id.$": "$.thread_id",
        "resume": true,
        "pending.$": "$.turn.payload.pending"
      },
      "Next": "AgentTurn"
    },

    "Respond": {
      "Type": "Pass",
      "Comment": "Shape the final response the caller polls for.",
      "Parameters": {
        "status": "done",
        "thread_id.$": "$.thread_id",
        "answer.$": "$.turn.payload.answer"
      },
      "Next": "Done"
    },

    "Done": { "Type": "Succeed" },
    "Failed": { "Type": "Fail", "Error": "AgentError", "Cause": "The agent turn failed." }
  }
}
