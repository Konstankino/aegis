# Copy to terraform.tfvars and adjust. All values are optional (defaults shown).

region         = "us-east-1"
project_name   = "aegis-demo"
architecture   = "arm64"      # must match your cargo-lambda cross-compile target ("arm64" | "x86_64")
python_runtime = "python3.12"

# Put the agent Lambda in a private, no-default-route subnet with closed-egress SG so the
# egress-containment posture is real. Set false for a faster deploy without networking.
enable_vpc = true

# Invoke the function during `apply` and print the Aegis decision trace as an output.
run_demo = true

# Deploy the auto-approver Lambda so the Step Functions demo resumes waitForTaskToken pauses
# automatically. Set false to approve manually (the task token lands in the approval SQS queue).
auto_approve = true

# Attach an OpenTelemetry (ADOT) collector Lambda layer to export OTLP traces + metrics to
# X-Ray + CloudWatch. Leave empty to run with structured logs only. Find the ARN for your
# region+arch at https://aws-otel.github.io/docs/getting-started/lambda
# otel_collector_layer_arn = "arn:aws:lambda:us-east-1:901920570463:layer:aws-otel-collector-arm64-ver-0-115-0:1"

log_retention_days = 14

# JIT credential grants (ASI03/ASI06). Each entry provisions least-privilege IAM plumbing for the
# /credentials/issue gate WITHOUT giving the standing agent role any data-plane access. After
# `apply`, copy `terraform output jit_role_arns` into the matching grants' `role_arn` in
# policies/grants.toml. Leave empty ({}) to keep the JIT broker default-deny.
# jit_grants = {
#   patient-db-read = {
#     kind          = "sts"
#     actions       = ["rds-db:connect"]
#     resource_arns = ["arn:aws:rds-db:us-east-1:111122223333:dbuser/prod-patients/reader"]
#   }
#   payments-api-key = {
#     kind       = "secret"
#     secret_arn = "arn:aws:secretsmanager:us-east-1:111122223333:secret:payments/api-key-AbCdEf"
#   }
# }
jit_grants = {}

# ── Separate, optional modules (properly layered — see docs/infrastructure-layers.md) ──────────────
# The RAG *engine* Aegis governs — a pgvector vector store (modules/rag). Off by default; needs a VPC.
# Omit it for a pure tool-calling agent, or to point the RetrievalBackend adapter at an existing store.
enable_rag = false

# The observability dashboard — Arize Phoenix (modules/phoenix). Off by default; needs a VPC. Swap for
# Langfuse/Grafana by leaving this off and deploying that stack against the same OTLP export.
enable_phoenix   = false
phoenix_ui_cidrs = [] # e.g. ["10.0.0.0/8"] — the VPN/bastion range allowed to reach the internal UI
